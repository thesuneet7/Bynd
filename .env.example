# ---- LLM (products/customers extraction from PDFs) ----
CLAUDE_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_CHEAP_MODEL=claude-haiku-4-5

# ---- Web scraping (unlisted products/customers from company website) ----
FIRECRAWL_API_KEY=fc-...
PREFER_FIRECRAWL=true

# ---- Document parsing ----
LLAMAPARSE_API_KEY=llx-...

# ---- Screener.in (required for full Key Insights on listed companies) ----
# Without these: financials still work; overview is only the public About blurb + teaser.
# With login: full Key Insights wiki (Read More) — see overview.py / screener_session.py
SCREENER_USERNAME=your@email.com
SCREENER_PASSWORD=your_password
# httpx | browser | auto
SCREENER_LOGIN=auto

# ---- Budget caps ----
MAX_LLAMAPARSE_PAGES=0
MAX_FIRECRAWL_SCRAPES=25
MAX_WEBSITE_AGENT_ROUNDS=5
MAX_WEBSITE_MAP_URLS=80
MAX_WEBSITE_EXPLORE_PAGES=40
MAX_WEBSITE_CLICKS_PER_PAGE=35
MAX_WEBSITE_IMAGES=200
MAX_WEBSITE_VISION_IMAGES=60
MAX_CLAUDE_CALLS=80
LLM_MAX_TOKENS=4000
