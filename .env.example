# ---- LLMs ----
# Writer / structural model (Anthropic)
CLAUDE_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_CHEAP_MODEL=claude-haiku-4-5

# Independent verifier (xAI Grok) — OpenAI-compatible endpoint
XAI_API_KEY=xai-...
XAI_MODEL=grok-4.3
XAI_BASE_URL=https://api.x.ai/v1

# ---- Tools ----
TAVILY_API_KEY=tvly-...
EXA_API_KEY=exa-...
FIRECRAWL_API_KEY=fc-...
LLAMAPARSE_API_KEY=llx-...

# ---- Search & scrape ----
SEARCH_PROVIDER=tavily            # ddg | tavily | exa | ddg_then_tavily | exa_then_tavily | exa_ddg_then_tavily
PREFER_FIRECRAWL=true             # Firecrawl before httpx when budget allows

# ---- Budget caps ----
MAX_DDG_SEARCHES=4             # free DuckDuckGo backup searches per run
MAX_TAVILY_SEARCHES=25         # primary search budget; recursive planner stops at this cap
MAX_EXA_SEARCHES=4             # semantic search for hidden/relevant pages
MAX_FIRECRAWL_SCRAPES=25       # primary extraction budget; cache avoids re-spend
MAX_LLAMAPARSE_PAGES=0       # disabled by default; local pypdf extraction first
MAX_CLAUDE_CALLS=20
MAX_GROK_CALLS=25
LLM_MAX_TOKENS=2500
